<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/scannerFragment">

    <action
        android:id="@+id/action_global_editOrderFragment"
        app:destination="@id/editOrderFragment" />

    <fragment
        android:id="@+id/scannerFragment"
        android:name="ru.faserkraft.client.presentation.scanner.ScannerFragment"
        android:label="fragment_scanner"
        tools:layout="@layout/fragment_scanner">
        <action
            android:id="@+id/action_scannerFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_scannerFragment_to_productFragment"
            app:destination="@id/productFragment" />
        <action
            android:id="@+id/action_scannerFragment_to_newProductFragment"
            app:destination="@id/newProductFragment" />
        <action
            android:id="@+id/action_scannerFragment_to_newPackagingFragment"
            app:destination="@id/newPackagingFragment" />
        <action
            android:id="@+id/action_scannerFragment_to_packagingFragment"
            app:destination="@id/packagingFragment" />
    </fragment>

    <fragment
        android:id="@+id/storageContainerFragment"
        android:name="ru.faserkraft.client.presentation.packaging.StorageContainerFragment"
        android:label="Склад"
        tools:layout="@layout/fragment_storage_container">
        <action
            android:id="@+id/action_storageContainerFragment_to_packagingListFragment"
            app:destination="@id/packagingListFragment" />
        <action
            android:id="@+id/action_storageContainerFragment_to_ordersFragment"
            app:destination="@id/ordersFragment" />
        <action
            android:id="@+id/action_storageContainerFragment_to_orderPackagingFragment"
            app:destination="@id/orderPackagingFragment" />
        <action
            android:id="@+id/action_storageContainerFragment_to_newOrderFragment"
            app:destination="@id/newOrderFragment" />
        <action
            android:id="@+id/action_storageContainerFragment_to_orderAddPackagingFragment"
            app:destination="@id/orderAddPackagingFragment" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="ru.faserkraft.client.presentation.registration.RegistrationFragment"
        android:label="fragment_registration"
        tools:layout="@layout/fragment_registration">
        <action
            android:id="@+id/action_registrationFragment_to_qrGenerationFragment"
            app:destination="@id/qrGenerationFragment" />
    </fragment>

    <fragment
        android:id="@+id/productFragment"
        android:name="ru.faserkraft.client.presentation.product.detail.ProductFragment"
        android:label="fragment_product"
        tools:layout="@layout/fragment_product">
        <action
            android:id="@+id/action_productFragment_to_productFullFragment"
            app:destination="@id/productFullFragment" />
        <action
            android:id="@+id/action_productFragment_to_editProductFragment"
            app:destination="@id/editProductFragment" />
        <action
            android:id="@+id/action_productFragment_to_editProductStatusFragment"
            app:destination="@id/editProductStatusFragment" />
        <action
            android:id="@+id/action_productFragment_to_packagingFragment"
            app:destination="@id/packagingFragment" />
    </fragment>

    <fragment
        android:id="@+id/productFullFragment"
        android:name="ru.faserkraft.client.presentation.product.detail.ProductFullFragment"
        android:label="ProductFullFragment"
        tools:layout="@layout/fragment_product_full">
        <action
            android:id="@+id/action_productFullFragment_to_editStepFragment"
            app:destination="@id/editStepFragment" />
    </fragment>

    <fragment
        android:id="@+id/newProductFragment"
        android:name="ru.faserkraft.client.presentation.product.detail.edit.NewProductFragment"
        android:label="fragment_new_product"
        tools:layout="@layout/fragment_new_product">
        <action
            android:id="@+id/action_newProductFragment_to_productFragment"
            app:destination="@id/productFragment" />
    </fragment>

    <fragment
        android:id="@+id/dayPlanFragment"
        android:name="ru.faserkraft.client.presentation.plan.DayPlanFragment"
        android:label="fragment_day_plan"
        tools:layout="@layout/fragment_day_plan">
        <action
            android:id="@+id/action_dayPlanFragment_to_addDayPlanFragment"
            app:destination="@id/addDayPlanFragment" />
        <action
            android:id="@+id/action_dayPlanFragment_to_employeePlanProductsFragment"
            app:destination="@id/employeePlanProductsFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProductFragment"
        android:name="ru.faserkraft.client.presentation.product.detail.edit.EditProductFragment"
        android:label="fragment_edit_product"
        tools:layout="@layout/fragment_edit_product" />

    <fragment
        android:id="@+id/editProductStatusFragment"
        android:name="ru.faserkraft.client.presentation.product.detail.edit.EditProductStatusFragment"
        android:label="fragment_edit_status_product"
        tools:layout="@layout/fragment_edit_status_product" />

    <fragment
        android:id="@+id/editStepFragment"
        android:name="ru.faserkraft.client.presentation.product.detail.edit.EditStepFragment"
        android:label="EditStepFragment"
        tools:layout="@layout/fragment_edit_step" />

    <fragment
        android:id="@+id/addDayPlanFragment"
        android:name="ru.faserkraft.client.presentation.plan.AddDayPlanFragment"
        android:label="fragment_add_day_plan"
        tools:layout="@layout/fragment_add_day_plan" />

    <fragment
        android:id="@+id/qrGenerationFragment"
        android:name="ru.faserkraft.client.presentation.registration.QrGenerationFragment"
        android:label="fragment_qr_generation"
        tools:layout="@layout/fragment_qr_generation" />

    <!-- Контейнер с вкладками -->
    <fragment
        android:id="@+id/inventoryContainerFragment"
        android:name="ru.faserkraft.client.presentation.product.inventory.InventoryContainerFragment"
        android:label="Инвентаризация"
        tools:layout="@layout/fragment_product_container">

        <action
            android:id="@+id/action_inventoryContainerFragment_to_productsInventoryByProcessFragment"
            app:destination="@id/productsInventoryByProcessFragment" />

        <action
            android:id="@+id/action_inventoryContainerFragment_to_productsReworkScrapFragment"
            app:destination="@id/productsReworkScrapFragment" />

        <!-- ДОБАВЛЕНО: Этот экшен должен быть здесь, чтобы навигация работала из ViewPager -->
        <action
            android:id="@+id/action_inventoryContainerFragment_to_productsReworkScrapListFragment"
            app:destination="@id/productsReworkScrapListFragment" />
    </fragment>

    <!-- Вкладка (оставляем просто фрагмент без экшенов, так как рулит контейнер) -->
    <fragment
        android:id="@+id/productsReworkScrapFragment"
        android:name="ru.faserkraft.client.presentation.product.inventory.ProductsReworkScrapListFragment"
        android:label="fragment_products_rework_scrap"
        tools:layout="@layout/fragment_products_rework_scrap" />

    <!-- Список отфильтрованных модулей (брак/переделка) -->
    <fragment
        android:id="@+id/productsReworkScrapListFragment"
        android:name="ru.faserkraft.client.presentation.product.inventory.ProductsReworkScrapListFragment"
        android:label="fragment_products_rework_scrap_list"
        tools:layout="@layout/fragment_products_rework_scrap_list">

        <!-- ДОБАВЛЕНО: Экшен для перехода в детали продукта по клику на элемент списка -->
        <action
            android:id="@+id/action_productsReworkScrapListFragment_to_productFullFragment"
            app:destination="@id/productFullFragment" />
    </fragment>
    <fragment
        android:id="@+id/productsInventoryByProcessFragment"
        android:name="ru.faserkraft.client.presentation.product.inventory.ProductsInventoryByProcessFragment"
        android:label="fragment_products_inventory_by_process"
        tools:layout="@layout/fragment_products_inventory_by_process">
        <action
            android:id="@+id/action_productsInventoryByProcessFragment_to_productFullFragment"
            app:destination="@id/productFullFragment" />
    </fragment>

    <fragment
        android:id="@+id/newPackagingFragment"
        android:name="ru.faserkraft.client.presentation.packaging.NewPackagingFragment"
        android:label="fragment_new_packaging"
        tools:layout="@layout/fragment_new_packaging">
        <action
            android:id="@+id/action_newPackagingFragment_to_packagingFragment"
            app:destination="@id/packagingFragment" />
    </fragment>

    <fragment
        android:id="@+id/packagingFragment"
        android:name="ru.faserkraft.client.presentation.packaging.PackagingFragment"
        android:label="fragment_packaging"
        tools:layout="@layout/fragment_packaging">
        <argument
            android:name="packagingSerialNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <action
            android:id="@+id/action_packagingFragment_to_newPackagingFragment"
            app:destination="@id/newPackagingFragment" />
        <action
            android:id="@+id/action_packagingFragment_to_productFullFragment"
            app:destination="@id/productFullFragment" />
    </fragment>

    <fragment
        android:id="@+id/productsStorageFragment"
        android:name="ru.faserkraft.client.presentation.packaging.StorageFragment"
        android:label="fragment_products_storage"
        tools:layout="@layout/fragment_products_storage">
        <action
            android:id="@+id/action_productsStorageFragment_to_packagingListFragment"
            app:destination="@id/packagingListFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderAddPackagingFragment"
        android:name="ru.faserkraft.client.presentation.order.OrderAddPackagingFragment"
        android:label="Добавление в заказ"
        tools:layout="@layout/fragment_order_add_packaging">
        <argument
            android:name="orderId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/packagingListFragment"
        android:name="ru.faserkraft.client.presentation.packaging.PackagingListFragment"
        android:label="PackagingListFragment"
        tools:layout="@layout/fragment_packaging_list">
        <argument
            android:name="process"
            app:argType="string" />
        <action
            android:id="@+id/action_packagingListFragment_to_packagingFragment"
            app:destination="@id/packagingFragment" />
    </fragment>

    <fragment
        android:id="@+id/employeePlanProductsFragment"
        android:name="ru.faserkraft.client.presentation.plan.EmployeePlanProductsFragment"
        android:label="fragment_employee_plan_products"
        tools:layout="@layout/fragment_employee_plan_products">
        <action
            android:id="@+id/action_employeePlanProductsFragment_to_productFullFragment"
            app:destination="@id/productFullFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderPackagingFragment"
        android:name="ru.faserkraft.client.presentation.order.OrderPackagingFragment"
        android:label="Упаковки заказа"
        tools:layout="@layout/fragment_order_packaging">
        <argument
            android:name="orderId"
            app:argType="integer" />
        <action
            android:id="@+id/action_orderPackagingFragment_to_packagingFragment"
            app:destination="@id/packagingFragment" />
    </fragment>

    <fragment
        android:id="@+id/newOrderFragment"
        android:name="ru.faserkraft.client.presentation.order.NewOrderFragment"
        android:label="fragment_new_order"
        tools:layout="@layout/fragment_new_order" />

    <fragment
        android:id="@+id/ordersFragment"
        android:name="ru.faserkraft.client.presentation.order.OrdersFragment"
        android:label="OrdersFragment"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/editOrderFragment"
        android:name="ru.faserkraft.client.presentation.order.EditOrderFragment"
        android:label="Редактирование заказа"
        tools:layout="@layout/fragment_new_order" />

</navigation>