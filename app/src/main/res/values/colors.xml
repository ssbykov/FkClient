<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="step_done_bg">@color/status_success_bg</color>
    <color name="step_pending_bg">@color/status_warning_bg</color>

    <!-- Брендовый синий -->
    <color name="brand_blue">#24A0ED</color>
    <color name="brand_blue_dark">#0D75C9</color>
    <color name="brand_blue_light">#B4D6F5</color>

    <!-- Фоны и подложки -->
    <color name="bg_app">#F5F0F5</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="progress_track">#E3EDF7</color> <!-- Мягкая пастельная подложка прогресс-бара -->

    <!-- Тексты -->
    <color name="text_secondary">#757575</color> <!-- Нейтральный серый для доп. сведений -->

    <color name="status_success_bg">#E3F7E8</color>   <!-- NORMAL -->
    <color name="status_success_text">#1B5E20</color>

    <color name="status_warning_bg">#FFF3CD</color>
    <color name="status_warning_text">#7C4A03</color>  <!-- тёмно-оранжевый текст -->

    <color name="status_wrong_bg">#FFE0E0</color>     <!-- Брак (мягкий красный) -->
    <color name="status_wrong_text">#B71C1C</color>   <!-- тёмно-красный текст -->

    <!-- Несовпадение этапа или его отсутствие (красный) -->
    <color name="step_mismatch">@color/status_wrong_text</color>

    <!-- Совпадение этапа / успешный скан (зеленый) -->
    <color name="step_match">@color/status_success_text</color>
</resources>