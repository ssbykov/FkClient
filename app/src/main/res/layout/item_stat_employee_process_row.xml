<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Заголовок типоразмера - плашка с закруглёнными углами.
         Единственный источник отступа между группами типоразмеров -
         layout_marginTop здесь; внешний контейнер margin не задаёт,
         чтобы отступы не задваивались. -->
    <TextView
        android:id="@+id/tvSizeTypeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_size_type_header"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Типоразмер 3м2" />

    <!-- Список этапов конкретного типоразмера -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="false"
        tools:itemCount="2"
        tools:listitem="@layout/item_stat_step_row" />

</LinearLayout>
